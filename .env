# App settings (used by Docker — see docker-compose.yml)
PORT=3000
HOST=0.0.0.0
ENABLE_HTTPS=true
DATA_DIR=/app/data

# MinIO / S3 (Docker overrides S3_ENDPOINT to http://minio:9000)
AWS_REGION=us-east-1
AWS_S3_BUCKET=secure-files
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://127.0.0.1:9000
